# =========================
# gallery-pipeline/ is a LOCAL-ONLY Node tool (photo intake, review UI,
# publish script). It never runs on the production server, but it lives
# inside the site's document root, and the root .htaccess passes real
# files straight through - so without this, publish.js, review-server.js,
# package-lock.json etc. would be publicly readable over HTTP.
#
# Deny everything in this directory. The published gallery images live in
# /img/Gallery/ and the manifest is read server-side by gallery.php via
# the filesystem, so nothing here needs to be web-reachable.
#
# Both syntaxes are IfModule-guarded so this works whether the host runs
# Apache 2.4 (mod_authz_core) or 2.2 (mod_authz_host).

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
  <IfModule mod_authz_host.c>
    Order allow,deny
    Deny from all
  </IfModule>
</IfModule>
