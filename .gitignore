# vendor/, includes/vendor/, api/vendor/, phpspreadsheet_lib/vendor/ are
# intentionally tracked (not gitignored) - cPanel's deploy target has no
# Composer, so these must ship as real files in the repo, not be rebuilt
# from composer.lock. includes/vendor_backup/ is a stale unused duplicate,
# not referenced anywhere in the codebase - excluded.
/includes/vendor_backup/

# Runtime-generated data, not source
/tickets/
/pdfs/
/logs/
/storage/*.log
/error_log

# This session's local dead-file safety net - git replaces this role
/_archive/

# Old backup archive, not source (241MB)
/well-known.zip

# Debug artifact written by shopping.php on each checkout attempt -
# contains live Getnet auth payload, not meant to be persisted/versioned
/payload_sent.txt

# Stray unreferenced files - raw badge uploads already processed into img/badges/,
# and an orphaned homepage snapshot
/TC BOTB Left Aligned Black - L.png
/TC BOTB Left Aligned White - L.png
/Tripadvisor Badge Left.png
/Tripadvisor TC BOTB Left Aligned Black - L.png
/Tripadvisor TC BOTB Left Aligned White - L.png
/index (4).html

# OS cruft
.DS_Store

# Claude Code session scratch space - can accumulate leftover worktrees from
# other sessions (hundreds of MB), never source
/.claude/

# Gallery pipeline: local-only intake/review state, never source
/gallery-pipeline/incoming/
/gallery-pipeline/.state.json
/gallery-pipeline/.approved-queue.json
/gallery-pipeline/.env
/gallery-pipeline/node_modules/
